<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>À propos — Le Jardin Gourmand</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<script>tailwind.config={theme:{extend:{colors:{vert:'#12362a',vc:'#1e5240',creme:'#f3ead7',casse:'#faf7f0',or:'#b8923a'},fontFamily:{display:['"Playfair Display"','serif'],sans:['Inter','sans-serif']}}}}</script>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{background:#faf7f0;color:#12362a;font-family:Inter,sans-serif}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:999px;padding:.75rem 1.5rem;font-size:.875rem;font-weight:600;transition:.2s;cursor:pointer}
.b-or{background:#b8923a;color:#12362a}.b-or:hover{background:#cfa648}.b-li{border:1px solid #faf7f0b3;color:#faf7f0}.b-li:hover{background:#faf7f0;color:#12362a}
.b-v{background:#12362a;color:#faf7f0}.b-v:hover{background:#1e5240}
.ch{width:100%;margin-top:.25rem;border:1px solid #12362a33;border-radius:.5rem;background:#fff;padding:.75rem 1rem}.ch:focus{outline:2px solid #b8923a66;border-color:#b8923a}
.pg{display:block}@keyframes f{from{opacity:0;transform:translateY(10px)}}
.card{background:#fff;border-radius:1rem;overflow:hidden;box-shadow:0 0 0 1px #12362a1a;transition:.3s}.card:hover{transform:translateY(-4px)}
@media(prefers-reduced-motion:reduce){.pg.on{animation:none}.card:hover{transform:none}}
</style></head><body>
<header class="sticky top-0 z-50 bg-black text-casse"><div class="max-w-6xl mx-auto flex items-center justify-between px-5 py-2">
<a href="index.html"><img src="data:image/jpeg;base64," alt="Le Jardin Gourmand" class="h-14"></a>
<nav id="nav" class="hidden md:flex gap-7 text-sm"></nav>
<button id="bt" class="md:hidden p-2 text-2xl" aria-label="Menu">☰</button></div>
<nav id="mn" class="hidden md:hidden flex-col px-5 pb-4"></nav></header>
<main><section id="apropos" class="pg"><div class="max-w-6xl mx-auto px-5 py-16 grid md:grid-cols-2 gap-10 items-center"><div><h1 class="font-display text-4xl font-semibold">Notre histoire</h1><div class="h-px w-16 bg-or mt-3 mb-5"></div>
<p class="leading-relaxed text-vert/85">Le Jardin Gourmand est né d’une idée simple : réunir à Ouèdo une cuisine africaine généreuse et des classiques internationaux, dans un cadre chic et chaleureux. Ici, le poulet se braise lentement, le poisson arrive frais et chaque assiette est dressée avec soin.</p>
<p class="mt-4 leading-relaxed text-vert/85">Notre équipe accueille chaque client comme un invité : vous repartez rassasié, détendu, avec l’envie de revenir.</p><p class="mt-4 text-xs text-vert/60">Histoire fictive, imaginée pour la démonstration.</p></div><img src="data:image/jpeg;base64," alt="Salle du restaurant" class="rounded-2xl shadow-xl"></div>
<div class="bg-creme py-16"><div class="max-w-6xl mx-auto px-5 grid md:grid-cols-3 gap-8">
<div><div class="text-3xl">🌿</div><h3 class="font-display text-xl font-semibold mt-2">Produits frais</h3><p class="mt-2 text-vert/75">Des ingrédients choisis chaque matin auprès de producteurs locaux.</p></div>
<div><div class="text-3xl">👨‍🍳</div><h3 class="font-display text-xl font-semibold mt-2">Cuisine maison</h3><p class="mt-2 text-vert/75">Sauces, marinades et desserts préparés sur place.</p></div>
<div><div class="text-3xl">🤝</div><h3 class="font-display text-xl font-semibold mt-2">Clients d’abord</h3><p class="mt-2 text-vert/75">Un service attentif et une cuisine adaptée à vos envies.</p></div></div></div></section></main>
<footer class="bg-black text-casse/80 text-sm"><div class="max-w-6xl mx-auto px-5 py-10 grid sm:grid-cols-2 gap-6"><div><img src="data:image/jpeg;base64," alt="" class="h-20"><p class="mt-2">Le plaisir de bien manger, à chaque instant.</p></div><div><p>Ouèdo, Abomey-Calavi, Bénin</p><p class="mt-1">+229 00 00 00 00 (fictif)</p></div></div>
<p class="border-t border-casse/10 px-5 py-4 text-center text-xs">Site de démonstration réalisé par AdenX. Restaurant, coordonnées, menu et tarifs entièrement fictifs.</p></footer>
<script>
const PAGE='apropos';const WA='22900000000',wa=t=>`https://wa.me/${WA}?text=${encodeURIComponent(t)}`;
const I={plat:'',dessert:'',vin:'',champagne:'',whisky:'',biere:'',boissons:'',salle:'data:image/jpeg;base64,'};
const CATS=[['tous','Tout'],['entrees','Entrées'],['plats','Plats principaux'],['desserts','Desserts'],['boissons','Boissons'],['vins','Vins'],['alcools','Alcools']];
const DI={entrees:'plat',plats:'plat',desserts:'dessert',boissons:'boissons',vins:'vin',alcools:'whisky'};
const m=(c,n,p,d,i)=>({c,n,p,d,i:i||DI[c]});
const M=[m('entrees','Salade composée du chef',2500,'Crudités de saison, œuf, maïs et vinaigrette maison.'),m('entrees','Avocat aux crevettes',3500,'Avocat fondant, crevettes décortiquées, sauce rose légère.'),m('entrees','Ailes de poulet grillées',3000,'Marinées aux épices, grillées à la braise.'),m('entrees','Nems au poulet',2000,'Croustillants, servis avec sauce douce-pimentée.'),m('entrees','Salade César',3500,'Laitue croquante, poulet grillé, parmesan, croûtons.'),
m('plats','Poulet braisé & alloco',4500,'Poulet mariné braisé, bananes plantains frites.'),m('plats','Poisson braisé avec riz',5500,'Poisson du jour braisé, riz parfumé, sauce tomate.'),m('plats','Chawarma poulet',2500,'Pain moelleux, poulet effiloché, crudités, sauce ail.'),m('plats','Spaghetti aux fruits de mer',6000,'Pâtes al dente, crevettes et fruits de mer en sauce.'),m('plats','Riz au poulet façon chef',4000,'Riz parfumé aux épices, poulet tendre et légumes.'),m('plats','Hamburger maison',3500,'Pain brioché, bœuf, cheddar, légumes frais, frites.'),m('plats','Brochettes de bœuf avec frites',4500,'Bœuf tendre grillé au feu de bois, frites dorées.'),m('plats','Tilapia braisé',7000,'Tilapia entier braisé, sauce et attiéké.'),
m('desserts','Fondant au chocolat',2500,'Cœur coulant, chocolat noir intense.'),m('desserts','Crêpes gourmandes',2000,'Crêpes fines, sauce chocolat ou miel.'),m('desserts','Salade de fruits',1500,'Fruits frais de saison, citron vert.'),m('desserts','Glace trois parfums',2000,'Trois boules au choix, bien fraîches.'),
m('boissons','Eau minérale',500,'Bouteille fraîche.'),m('boissons','Coca-Cola',700,'Bien glacé.'),m('boissons','Fanta',700,'Bien glacée.'),m('boissons','Sprite',700,'Bien glacé.'),m('boissons','Jus d’ananas naturel',1500,'Pressé, sans sucre ajouté.'),m('boissons','Jus de bissap',1000,'Hibiscus, menthe et sucre de canne.'),m('boissons','Cocktail de fruits sans alcool',2000,'Fruits frais, glaçons pilés.'),
m('vins','Vin rouge',8000,'Rond et fruité, pour les viandes grillées.'),m('vins','Vin rosé',7500,'Frais et léger, idéal sous la chaleur.'),m('vins','Vin blanc',9000,'Vif et élégant, pour poissons et fruits de mer.'),
m('alcools','Bière locale',1000,'Bière béninoise très fraîche.','biere'),m('alcools','Heineken',1500,'Lager premium, bouteille glacée.','biere'),m('alcools','Desperados',2000,'Bière aromatisée à la tequila.','biere'),m('alcools','Whisky au verre',3000,'Servi sur glace ou sec.','whisky'),m('alcools','Champagne',25000,'Bouteille servie en seau à glace.','champagne')];
const F=n=>n.toLocaleString('fr-FR').replace(/\s/g,' ')+' FCFA';
const card=p=>`<article class="card"><img src="${I[p.i]}" alt="${p.n}" loading="lazy" class="h-52 w-full object-cover"><div class="p-5"><div class="flex justify-between gap-3 items-baseline"><h3 class="font-display text-lg font-semibold">${p.n}</h3><span class="font-semibold text-or shrink-0">${F(p.p)}</span></div><p class="mt-2 text-sm text-vert/70">${p.d}</p></div></article>`;
const P=[['accueil','Accueil'],['menu','Notre menu'],['apropos','À propos'],['galerie','Galerie'],['reservation','Réservation'],['contact','Contact']];
const lk=c=>P.map(([h,n])=>`<a href="${h=='accueil'?'index':h}.html" data-h="${h}" class="${c}">${n}</a>`).join('');
nav.innerHTML=lk('py-2 hover:text-or');mn.innerHTML=lk('py-3 border-b border-casse/10 text-casse');mn.className+=' bg-black text-casse';
bt.onclick=()=>{mn.classList.toggle('hidden');mn.classList.toggle('flex')};
if(window.best)best.innerHTML=['Poulet braisé & alloco','Tilapia braisé','Brochettes de bœuf avec frites'].map(n=>card(M.find(x=>x.n===n))).join('');
function show(c){grille.innerHTML=M.filter(x=>c=='tous'||x.c==c).map(card).join('');fil.innerHTML=CATS.map(([k,n])=>`<button data-k="${k}" class="shrink-0 rounded-full border px-5 py-2 text-sm ${k==c?'bg-vert text-casse border-vert':'border-vert/25'}">${n}</button>`).join('');fil.querySelectorAll('button').forEach(b=>b.onclick=()=>show(b.dataset.k))}if(window.grille)show('tous');
if(window.gal)gal.innerHTML=[['plat','Poulet braisé, riz et alloco'],['salle','Notre salle'],['vin','Vins'],['dessert','Petits plaisirs'],['champagne','Champagne'],['whisky','Whisky'],['biere','Bières fraîches'],['boissons','Rafraîchissements']].map(([k,a])=>`<img src="${I[k]}" alt="${a}" loading="lazy" class="mb-4 w-full rounded-xl">`).join('');
if(window.fr)document.querySelector('[name=date]').min=new Date().toISOString().slice(0,10);
if(window.wac)wac.href=wa('Bonjour, j’aimerais avoir des informations.');
if(window.fr)fr.onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(fr));
if(!/^[+\d\s]{8,16}$/.test(d.tel)){er.textContent='Entrez un numéro de téléphone valide (8 chiffres minimum).';return}er.textContent='';
window.open(wa(`Bonjour, je souhaite réserver au Jardin Gourmand.\nNom : ${d.nom}\nTéléphone : ${d.tel}\nDate : ${d.date}\nHeure : ${d.heure}\nPersonnes : ${d.pers}`+(d.msg?`\nMessage : ${d.msg}`:'')),'_blank','noopener')};
document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('text-or',a.dataset.h==PAGE));
</script></body></html>
